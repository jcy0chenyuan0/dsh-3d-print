/*
	flow-wall — 单壁厚阶梯（挤出流量 / 线宽）

	测什么
		四片单壁薄板，设计壁厚 0.4 / 0.5 / 0.6 / 0.8 mm，高 20 mm。
		每片只用一条挤出线，打完用卡尺量实际壁厚 = 实际线宽。

	怎么判读
		- 0.4 片量出 0.42–0.46 mm 属正常：切片器按 0.42 线宽外扩。
		- 四片全部偏薄（<设计值-0.03）：流量不足，flow 从 95% 往 100% 调。
		- 四片全部偏厚（>设计值+0.06）：流量过量，flow 降到 95% 左右或降温度。
		- 四片之间厚度差 >0.05 mm：线宽随速度/温度漂移，先稳速度再调流量。
		- 壁面有针孔 = 流量不足；有毛边鼓包 = 流量过量 / 温度过高 / 回抽不足。
		- 打印方式：1 圈外墙、0 填充、0 顶底；**不要用花瓶模式**（四片是分离实体，
		  花瓶模式会在片间断开）。四片之间会有空驶，出现拉丝属正常，不影响壁厚判读。

	期望值（默认参数）
		STL 体积 1.160 cm³，包围盒 95.00 × 3.00 × 21.00 mm，4 个独立实体，水密。
		每片壁厚 = 参数值（模型是精确的，误差只可能来自打印）。

	参数
		wall_t1..t4  四片设计壁厚 (mm)
		wall_w       每片宽 (X)
		wall_h       每片高 (Z)
		gap          片间净距 (X)
		base_d/base_h  贴床小垫脚：只负责粘床，不参与厚度判读
*/

/* [单壁阶梯 (mm)] */
wall_t1 = 0.4;    // 第 1 片设计壁厚
wall_t2 = 0.5;    // 第 2 片
wall_t3 = 0.6;    // 第 3 片
wall_t4 = 0.8;    // 第 4 片

/* [尺寸] */
wall_w = 20;      // 每片宽 (X)
wall_h = 20;      // 每片高 (Z)
gap = 5;          // 片间净距 (X)

/* [垫脚：只为贴床] */
base_d = 3;       // 垫脚深 (Y)
base_h = 1;       // 垫脚高 (Z)

assert(wall_w > 0 && wall_h > 0, "wall_w / wall_h 必须 > 0");
assert(min([wall_t1, wall_t2, wall_t3, wall_t4]) > 0, "壁厚必须 > 0");
assert(base_d > max([wall_t1, wall_t2, wall_t3, wall_t4]), "base_d 必须大于最厚的一片，否则壁片会悬在垫脚外");

module flow_patch(t) {
	// 垫脚 + 居中直壁：壁片从垫脚顶面起算，底面与垫脚共面并压进 0.01，
	// 避免两个实体只共面接触（CGAL 对这种共面并集偶尔会留下内壁）。
	translate([0, -base_d / 2, 0]) cube([wall_w, base_d, base_h]);
	translate([0, -t / 2, base_h - 0.01]) cube([wall_w, t, wall_h + 0.01]);
}

for (i = [0:3]) {
	t = [wall_t1, wall_t2, wall_t3, wall_t4][i];
	translate([i * (wall_w + gap), 0, 0]) flow_patch(t);
}
