/*
	z-ladder — 层高标记阶梯（1.0/1.5/2.0/2.5/3.0 mm）

	测什么
		五个方块，高度 1.0 / 1.5 / 2.0 / 2.5 / 3.0 mm。
		用候选层高打一遍，量每块实际高度：能被层高整除的块，顶面正好是一层的
		结束；不能整除的块，顶面会落在半层上，高度和表面纹理都会露馅。

	怎么判读
		- 卡尺量五块实际高度，与设计值比对。
		- 除以层数（侧面数条纹可数）反推**实际层高**：实测高度 / 层数。
		- 0.2 层高下：1.0 / 2.0 / 3.0 是整数层（5/10/15 层），
		  1.5 / 2.5 是 7.5 / 12.5 层——这两块顶面会少半层、看起来发亮/被压。
		- 0.15 层高下反过来：1.5 / 3.0 正好，1.0 / 2.0 不整除。
		- 五块高度全部比设计值少 0.1–0.2 mm：首层被压，调 z-offset。
		- 如果 1.0 块量出 1.4：说明实际层高 0.28 而不是 0.2（层高被切片器抬了）。

	期望值（默认参数）
		STL 体积 2.250 cm³，包围盒 87.00 × 15.00 × 3.00 mm，5 个独立实体，水密。
		Z 包围盒 = 最高的那块 3.0 mm。

	参数
		h_1..5       五块高度 (mm)
		block_w/d    每块宽 / 深 (mm)
		gap          块间距 (X)
*/

/* [标记块高度 (mm)] */
h_1 = 1.0;        // 5 × 0.2 层
h_2 = 1.5;        // 7.5 × 0.2 层：不整除，顶面会露馅
h_3 = 2.0;        // 10 × 0.2 层
h_4 = 2.5;        // 12.5 × 0.2 层
h_5 = 3.0;        // 15 × 0.2 层

/* [尺寸] */
block_w = 15;     // 每块 X
block_d = 15;     // 每块 Y
gap = 3;          // 块间距 (X)

assert(min([h_1, h_2, h_3, h_4, h_5]) > 0, "块高必须 > 0");
assert(block_w > 0 && block_d > 0, "block_w / block_d 必须 > 0");

heights = [h_1, h_2, h_3, h_4, h_5];
n_blocks = len(heights);

union() {
	for (i = [0:n_blocks - 1]) {
		translate([i * (block_w + gap), 0, 0]) cube([block_w, block_d, heights[i]]);
	}
}
