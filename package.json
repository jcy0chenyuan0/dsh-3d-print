{
  "name": "dsh-3d-print",
  "version": "0.1.0",
  "private": true,
  "description": "OpenSCAD-first 3D printing toolkit for DeepSeek Harness: parametric modeling, mesh QA, slicer interop, Blender bridge, calibration test bodies.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/**/*.js",
    "lib/tools/*.js",
    "assets/**",
    "blender/**",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh-plugin",
    "dsh-bundle",
    "openscad",
    "3d-printing",
    "stl",
    "blender",
    "slicer"
  ],
  "license": "MIT"
}
